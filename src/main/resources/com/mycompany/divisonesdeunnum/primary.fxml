<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" 
      spacing="20.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.divisonesdeunnum.PrimaryController">
    
   <children>
      <Label text="Ingrese un número " />
      <TextField fx:id="txtnumero" text="" />
      
      
      <Button fx:id="btnAnalizar" 
              text="Analizar" 
              onAction="#btnAnalizar_click"/>
      
      <Button fx:id="btnLimpiar" 
              text="Limpiar" 
              onAction="#btnLimpiar_click"/>
      
      <Label fx:id="lbl0" text="Divisores:" />
      
      <Label fx:id="lbl1" text="Cantidad de cifras " />
      <Label fx:id="lbl2" text="Suma de cifras impares " />
      <Label fx:id="lbl3" text="Suma de cifras pares " /> 
      <Label fx:id="lbl4" text="Suma total de cifras " />
      <Label fx:id="lbl5" text="Cifra mayor " />
      <Label fx:id="lbl6" text="Cifra menor " />
      
      
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
